{
  "kb_dir": "knowledge",
  "runtime_dir": ".runtime",

  "auto_commit": true,
  "auto_push": false,

  "watcher": {
    "poll_seconds": 45,
    "quiet_seconds": 120,
    "batch_max": 20,
    "idle_exit_seconds": 900
  },

  "distill": {
    "timeout_seconds": 900,
    "max_attempts": 3,
    "max_batch_records": 40
  },

  "capture": {
    "codex_ide": true,
    "max_pending_records": 400,
    "skip_binaries": []
  },

  "writer": {
    "prefer": ["devin", "claude", "codex", "copilot", "opencode", "cursor-agent"]
  }
}
