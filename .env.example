# Copy to .env next to config.json. Process environment variables take precedence.
# Use an Ollama model already installed on your machine.
AI_SKILLS_OLLAMA_MODEL=gemma4:12b
AI_SKILLS_OLLAMA_URL=http://localhost:11434/api/generate
# AI_SKILLS_OLLAMA_API_KEY=your-key-here

# OpenAI-compatible clients (ask.py and playback_chat.py).
# If CHAT_MODEL is omitted, the Ollama writer model is used.
AI_SKILLS_CHAT_URL=http://localhost:11434/v1/chat/completions
# AI_SKILLS_CHAT_MODEL=gemma4:12b
# AI_SKILLS_CHAT_API_KEY=your-key-here
# For playback_chat.py --ollama-cloud, set your Ollama API key here:
# OLLAMA_API_KEY=your-key-here

# Required for playback questions and command-knowledge search.
# Pull this local model with: ollama pull nomic-embed-text
AI_SKILLS_EMBED_MODEL=nomic-embed-text:latest
# AI_SKILLS_EMBED_URL=http://localhost:11434/api/embed

# Optional cloud CLI writer model overrides:
# AI_SKILLS_CLAUDE_MODEL=haiku
# AI_SKILLS_DEVIN_MODEL=swe-1-7-medium
# AI_SKILLS_CODEX_MODEL=
# AI_SKILLS_COPILOT_MODEL=
# AI_SKILLS_OPENCODE_MODEL=
# AI_SKILLS_CURSOR_AGENT_MODEL=

# Optional service credentials:
# AI_SKILLS_SEARCH_TOKEN=your-token-here
# AI_SKILLS_TEAM_URL=https://your-server.example
# AI_SKILLS_TEAM_TOKEN=your-long-token-here
# AI_SKILLS_TEAM_TOKENS={"machine-id":"your-long-token-here"}
